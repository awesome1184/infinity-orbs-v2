{
  "name": "infinity-orbs",
  "private": true,
  "version": "1.2.24",
  "type": "module",
  "scripts": {
    "dev": "devvit playtest",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "npm run type-check",
    "dev:local": "vite --config vite.local.config.ts --port=3000 --host=0.0.0.0",
    "dev:reddit": "devvit playtest",
    "login": "devvit login",
    "type-check": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "preflight:guard": "node scripts/predeploy-check.mjs",
    "preflight": "npm run preflight:guard && npm run type-check && npm test && npm run build",
    "deploy": "npm run preflight && devvit upload --version $(node -p 'require(\"./package.json\").version')",
    "launch": "npm run deploy && devvit publish",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "@devvit/start": "0.14.6",
    "@devvit/web": "0.14.6",
    "devvit": "0.14.6",
    "@devvit/payments": "0.14.6",
    "@devvit/notifications": "0.14.6",
    "@devvit/scheduler": "0.14.6"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
